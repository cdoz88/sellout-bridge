{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-meters",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/publish-posts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/clean-newsletters",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/issue-credits",
      "schedule": "0 0 1 * *"
    }
  ]
}